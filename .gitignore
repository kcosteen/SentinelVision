# Virtual environment
.venv/

# Python cache files
__pycache__/

# Compiled Python files
*.pyc

# pytest cache
.pytest_cache/

# Recorded sessions / extracted features (your own data — often private, can be large).
# Scoped to the top-level output dir so src/data/ code and the committed
# sample_features.csv schema example stay tracked.
/data/sessions/

# Built training table + trained model artifacts (derived from your private clips).
/data/dataset.csv
/models/

# Phase 2 detector data: downloaded public datasets (re-fetchable), frames cut from
# your private clips, and the merged YOLO dataset built from both. All derived or
# external — src/detection/ rebuilds any of it from scratch.
/data/detection/

# Raw recorded video clips (your own footage — private / large). Keep the folder + README.
/clips/*
!/clips/README.md

# Ultralytics scratch output (only appears if --project is given a relative path)
/runs/

# Editor / tooling settings (local, machine-specific)
.vscode/
.claude/settings.local.json